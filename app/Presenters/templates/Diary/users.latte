{block content}
<div id="banner">
    {if $user->isLoggedIn()}
        {* připravím timestamp pro návrat do správného týdne v rozvrhu *}
        <div class="text-warning text-center p-1 m-0" n:block=title style="font-size: 150%; letter-spacing: 2px">
            <strong>ADMINISTRACE: Lekce - klienti</strong>
                <a n:href="Diary:default ($info['ts_diary_date'] ?? null)" class="btn btn-sm btn-success" style="float: right;">
                    <i class="bi bi-arrow-left-circle-fill"></i> Zpět
                </a>
        </div>
    {/if}
</div>

<style>
    .lesson-info-panel {
        margin: 1.5rem .25rem;
        padding: 1rem 1.1rem;
        color: #4f4f4f;
        font: inherit;
        background: #fffef4;
        border: 1px solid #f1d56a;
        border-left: 5px solid #ffc107;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
    }

    .lesson-info-head {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1.25rem;
        align-items: flex-start;
        justify-content: space-between;
        padding-bottom: .85rem;
        margin-bottom: .75rem;
        border-bottom: 1px solid rgba(133, 100, 4, .2);
    }

    .lesson-info-kicker {
        display: block;
        margin-bottom: .15rem;
        color: #856404;
        font-weight: 700;
    }

    .lesson-info-title {
        margin: 0;
        color: #2f2f2f;
        font-weight: 700;
    }

    .lesson-info-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem 1rem;
        max-width: 100%;
        color: #5d5d5d;
    }

    .lesson-info-meta span,
    .lesson-info-rule,
    .lesson-info-label {
        display: inline-flex;
        gap: .35rem;
        align-items: center;
        min-width: 0;
    }

    .lesson-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem 1rem;
    }

    .lesson-info-metric,
    .lesson-info-rule {
        min-width: 0;
        padding: .15rem 0;
    }

    .lesson-info-label,
    .lesson-info-rule span {
        color: #6f6f6f;
        font-weight: 700;
    }

    .lesson-info-value {
        display: block;
        margin-top: .15rem;
        color: #2f2f2f;
        font-weight: 700;
    }

    .lesson-info-progress {
        height: .45rem;
        margin-top: .45rem;
        overflow: hidden;
        background: #ece7c3;
        border-radius: 999px;
    }

    .lesson-info-progress span {
        display: block;
        height: 100%;
        background: #198754;
        border-radius: inherit;
    }

    .lesson-info-progress.is-warning span {
        background: #ffc107;
    }

    .lesson-info-progress.is-full span {
        background: #dc3545;
    }

    .lesson-info-rules {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .35rem 1rem;
        padding-top: .75rem;
        border-top: 1px solid rgba(133, 100, 4, .16);
    }

    .lesson-info-rule strong {
        display: block;
        margin-top: .15rem;
        color: #2f2f2f;
        white-space: nowrap;
    }

    .lesson-info-rule {
        display: block;
    }

    @media (max-width: 991.98px) {
        .lesson-info-grid,
        .lesson-info-rules {
            grid-template-columns: 1fr;
        }
    }
</style>

{*
  b.`ID` as `diary_id`,
  b.`nazev` as `diary_nazev`,
  b.`popis` as `diary_popis`,
  b.`date` as `diary_date`,
  b.`hour_from` as `diary_hour_from`,
  b.`min_from` as `diary_min_from`,
  b.`hour_to` as `diary_hour_to`,
  b.`min_to` as `diary_`,
  b.`desc` as `diary_desc`,
  d.`id` as `aktivita_id`,
  d.`nazev` as `aktivita_nazev`,
  d.`vstupy_min` as `aktivita_vstupy_min`,
  d.`vstupy_max` as `aktivita_vstupy_max`,
  d.`zruseni_zdarma` as `aktivita_zruseni_zdarma`,
  d.`zruseni_zdarma_ts` as `aktivita_zruseni_zdarma_ts`,
  d.`zruseni_neucast` as `aktivita_zruseni_neucast`,
  d.`zruseni_neucast_ts` as `aktivita_zruseni_neucast_ts`,
  d.`registrace_konec` as `aktivita_registrace_konec`,
  d.`registrace_konec_ts` as `aktivita_registrace_konec_ts`,
  e.`id` as `lektor_id`,
  e.`surname` as `lektor_surname`,
  e.`firstname` as `lektor_firstname`,
  UNIX_TIMESTAMP(STR_TO_DATE(b.`date`, '%Y%m%d')) AS `ts_diary_date`,
  DATE_FORMAT(STR_TO_DATE(b.`date`, '%Y%m%d'), '%d.%m.%Y') AS `lekce_datum`,
  TIME_FORMAT(MAKETIME(b.`hour_from`, b.`min_from`, 0), '%H:%i') AS `lekce_cas_od`,
  TIME_FORMAT(MAKETIME(b.`hour_to`, b.`min_to`, 0), '%H:%i') AS `lekce_cas_do`
*}

<div id="content">

{if $user->isLoggedIn()}
    {* hlavní blok *}
    <div class="row">

        {* levý sloupec *}
        <div class="col-md-8" style="background-color: #FFFBBF;">

            {* lekce info blok *}
            {var $capacityMin = (int) $info['aktivita_vstupy_min']}
            {var $capacityMax = (int) $info['aktivita_vstupy_max']}
            {var $participantPercent = $capacityMax > 0 ? min(100, (int) round($participantCount / $capacityMax * 100)) : 0}
            {var $substitutePercent = $maxSubstitutes > 0 ? min(100, (int) round($substituteCount / $maxSubstitutes * 100)) : 0}
            {var $participantProgressClass = $capacityMax > 0 && $participantCount >= $capacityMax ? 'is-full' : ($participantCount < $capacityMin ? 'is-warning' : '')}
            {var $substituteProgressClass = $maxSubstitutes > 0 && $substituteCount >= $maxSubstitutes ? 'is-full' : ($substituteCount > 0 ? 'is-warning' : '')}
            <div class="lesson-info-panel">
                <div class="lesson-info-head">
                    <div>
                        <span class="lesson-info-kicker">{$info['aktivita_nazev']}</span>
                        <h2 class="lesson-info-title">{$info['diary_nazev']}</h2>
                    </div>
                    <div class="lesson-info-meta">
                        <span><i class="bi bi-person-badge-fill"></i>{$info['lektor_firstname']} {$info['lektor_surname']}</span>
                        <span><i class="bi bi-calendar-event-fill"></i>{$info['lekce_datum']}</span>
                        <span><i class="bi bi-clock-fill"></i>{$info['lekce_cas_od']} - {$info['lekce_cas_do']}</span>
                    </div>
                </div>

                <div class="lesson-info-grid">
                    <div class="lesson-info-metric">
                        <span class="lesson-info-label"><i class="bi bi-people-fill"></i>Obsazenost</span>
                        <strong class="lesson-info-value">{$participantCount} / {$capacityMax}</strong>
                        <div class="lesson-info-progress {$participantProgressClass}">
                            <span style="width: {$participantPercent|noescape}%;"></span>
                        </div>
                    </div>
                    <div class="lesson-info-metric">
                        <span class="lesson-info-label"><i class="bi bi-person-plus-fill"></i>Náhradníci</span>
                        <strong class="lesson-info-value">{$substituteCount} / {$maxSubstitutes}</strong>
                        <div class="lesson-info-progress {$substituteProgressClass}">
                            <span style="width: {$substitutePercent|noescape}%;"></span>
                        </div>
                    </div>
                    <div class="lesson-info-metric">
                        <span class="lesson-info-label"><i class="bi bi-ticket-perforated-fill"></i>Vstupy min/max</span>
                        <strong class="lesson-info-value">{$capacityMin} / {$capacityMax}</strong>
                    </div>

                    <div class="lesson-info-rules">
                        <div class="lesson-info-rule">
                            <span><i class="bi bi-arrow-counterclockwise"></i>Storno zdarma</span>
                            <strong>{$info['aktivita_zruseni_zdarma']} hod před lekcí</strong>
                        </div>
                        <div class="lesson-info-rule">
                            <span><i class="bi bi-person-x-fill"></i>Zrušení pro neúčast</span>
                            <strong>{$info['aktivita_zruseni_neucast']} hod před lekcí</strong>
                        </div>
                        <div class="lesson-info-rule">
                            <span><i class="bi bi-lock-fill"></i>Konec registrace</span>
                            <strong>{$info['aktivita_registrace_konec']} hod před lekcí</strong>
                        </div>
                    </div>
                </div>
            </div>
            {* lekce info blok - konec*}

            {* *** SEZNAM KLIENTŮ *** *}
            <div class="border border-2 border-warning p-2 mx-1 my-4" style="background-color: #fff;">
                {foreach $data as $key => $items}
                    {if $iterator->first}
                        <table id="tbl-users" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th>SMS</th>
                                    <th>Klient</th>
                                    <th>Stav</th>
                                    <th>Mobil</th>
                                    <th>Kredity</th>
                                    <th>Potvrzení<br>účasti</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                    {/if}

                    {if $items['registrace_deleted'] == 0}
                        {var $isSubstitute = (($items['registration_status'] ?? 'ucastnik') == 'nahradnik')}
                        <tr {if $isSubstitute}class="table-warning"{/if}>
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input multi-check"
                                           type="checkbox"
                                           id="sms-{$key|noescape}"
                                           name="sms_{$key|noescape}"
                                           value="{$items['user_mobil_number']|noescape}"
                                           >
                                    <label class="form-check-label"></label>
                                </div>
                            </td>
                            <td>
                                <a n:href="User:user $items['user_id']" style="color: #e67c2f !important;"><strong>{$items['user_surname']} {$items['user_firstname']}</strong></a>
                            </td>
                            <td>
                                <span class="badge {if $isSubstitute}text-bg-warning{else}text-bg-success{/if}" {if $isSubstitute}title="Pořadí v seznamu náhradníků"{/if}>
                                    {if $isSubstitute}Náhradník{if ($items['substitute_order'] ?? null)} #{$items['substitute_order']}{/if}{else}Účastník{/if}
                                </span>
                            </td>
                            <td>{$items['user_mobil_number']}</td>
                            <td>
                                {ifset $items->kredity}
                                    {foreach $items->kredity as $akey => $aitems}
                                        {if $aitems['kredity'] < 0}
                                            {var $astyle='color: red;'}
                                        {elseif $aitems['kredity'] == 0}
                                            {var $astyle='color: blue;'}
                                        {else}
                                            {var $astyle='color: green;'}
                                        {/if}
                                        <div>
                                            {$aktivita[$akey]} - <span style="{$astyle|noescape}"><strong>{$aitems['kredity']}</strong></span>
                                        </div>
                                    {/foreach}
                                {/ifset}
                            </td>
                            <td>
                                {if !$isSubstitute}
                                    {var $confirmFormId = "confirmForm-" . $items['registrace_id']}
                                    {form $confirmFormId}{input ucast}{/form}

                                    <script>
                                        $('#frm-{$confirmFormId|noescape}-ucast').val({$items['registrace_ucast']});
                                    </script>
                                {else}
                                    <span class="text-muted">-</span>
                                {/if}
                            </td>

                            <td class="text-center">
                                {var $cancelFormId = 'cancelRegistrationForm-' . $items['registrace_id']}
                                {form $cancelFormId}
                                    {if !$isSubstitute}
                                        <label class="small fw-bold me-3 px-1 py-1 my-1" style="background-color:#fff3cd;">
                                            {input vratit_vstup} vrátit kredit
                                        </label>
                                    {/if}
                                    {input send}
                                {/form}
                            </td>
                        </tr>
                    {/if}

                    {if $iterator->last}
                            </tbody>
                        </table>
                    {/if}
                {else}
                    <div class="text-center">Nebyl nalezen žádná záznam.</div>
                {/foreach}
            </div>

            {* *** VSTUPY *** *}
            <div class="border border-1 p-2 mx-1 my-4" style="background-color: #eee;">
                <div style="font-size: 120%; font-weight: bold;">Přehled všech registrací na lekci</div>
                {foreach $data as $key => $items}
                    {if $iterator->first}
                        <table class="table" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Klient</th>
                                    <th>Stav</th>
                                    <th>Datum registrace</th>
                                    <th>Kdo registroval</th>
                                    <th>Datum zrušení registrace</th>
                                    <th>Kdo zrušil registraci</th>
                                </tr>
                            </thead>
                            <tbody>
                    {/if}

                    {var $isSubstituteHistory = (($items['registration_status'] ?? 'ucastnik') == 'nahradnik')}
                    {if $items['registrace_deleted'] == 0 && $isSubstituteHistory}
                        {var $color = 'color: #b26a00;'}
                    {elseif $items['registrace_deleted'] == 0}
                        {var $color = 'color: green;'}
                    {else}
                        {var $color = 'color: red;'}
                    {/if}

                    <tr>
                        <td style="{$color|noescape}">{$items['user_surname']} {$items['user_firstname']}</td>
                        <td style="{$color|noescape}">{if $isSubstituteHistory}Náhradník{if ($items['substitute_order'] ?? null)} #{$items['substitute_order']}{/if}{else}Účastník{/if}</td>
                        <td style="{$color|noescape}">{$items['registrace_created_at']}</td>
                        <td style="{$color|noescape}">{$items['registrace_created_by']}</td>
                        <td style="{$color|noescape}">{$items['registrace_deleted_at']}</td>
                        <td style="{$color|noescape}">{$items['registrace_deleted_by']}</td>
                    </tr>

                    {if $iterator->last}
                            </tbody>
                        </table>
                    {/if}
                {else}
                    <div class="text-center">Nebyl nalezen žádná záznam.</div>
                {/foreach}
                <div>&nbsp;</div>
            </div>

        {* levý sloupec - konec*}
        </div>


        {* pravý sloupec *}
        <div class="col-md-4">
            {* *** REGISTRACE KLIENTA *** *}
            <div class="border border-1 p-2 mx-1 my-4" style="background-color: #eee;">
                <div style="font-size: 120%; font-weight: bold;">Registrovat klienta na lekci</div>
                <div class="p-2" style="text-align: center;">
                    {if $dataCount < $info['aktivita_vstupy_max']}
                        {form registerByAdminForm}
                            {input user_id}
                            <div class="p-2">
                                {input send}
                            </div>
                        {/form}
                    {elseif $substituteCount < $maxSubstitutes}
                        <div class="alert alert-warning small">Lekce je obsazena, klient bude zapsán jako náhradník.</div>
                        {form registerByAdminForm}
                            {input user_id}
                            <div class="p-2">
                                {input send}
                            </div>
                        {/form}
                    {else}
                        <div class="text-center">Lekce i seznam náhradníků jsou obsazeny.</div>
                    {/if}
                </div>

                <script>
                    $('#frm-registerByAdminForm-diary_id').val({$info['diary_id']});
                </script>

            </div>

            {* *** SMS *** *}
            <div class="border border-1 p-2 mx-1 my-4" style="background-color: #eee;">
                <div style="font-size: 120%; font-weight: bold;">SMS zpráva označeným klientům</div>
                <div class="p-2" style="text-align: center;">
                    {form sendSmsForm}
                        {input sms_mobile_numbers}
                        <div>{label sms_msg /}{input sms_msg}</div>
                        <div class="p-2">{input send}</div>
                    {/form}
                </div>
            </div>

        {* pravý sloupec - konec*}
        </div>

    {* hlavní blok - konec *}
    </div>

{/if}
</div>

{if $user->isLoggedIn()}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.multi-check');
            const hiddenInput = document.getElementById('frm-sendSmsForm-sms_mobile_numbers');

            function updateHiddenInput() {
                // vezmeme všechny zaškrtnuté checkboxy
                const values = Array.from(checkboxes)
                        .filter(cb => cb.checked)
                        .map(cb => cb.value);

                // spojíme je pomocí |
                hiddenInput.value = values.join('|');
            }

            // navěsíme listener na změnu stavu checkboxů
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateHiddenInput);
            });
        });

        let dataTableContact = new DataTable('#tbl-users', {
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/cs.json',
                search: "Vyhledávání v tabulce:",
                searchPlaceholder: "zadejte hledaný text"
            },

            // výchozí řazení podle "Klient" (2. sloupec = index 1)
            order: [[1, 'asc']],

            columnDefs: [
                // povolit třídění jen u sloupce "Klient"
                {
                    orderable: true, targets: 1
                },

                // všechny ostatní sloupce netřídit
                {
                    orderable: false, targets: [0, 2, 3, 4, 5]
                }
            ]
        });
    </script>
{/if}

{*
  a.`ID` as `registrace_id`,
  a.`ucast` as `registrace_ucast`,
  a.`desc` as `registrace_desc`,
  a.`created_at` as `registrace_created_at`,
  a.`created_by` as `registrace_created_by`,
  a.`deleted` as `registrace_deleted`,
  a.`deleted_at` as `registrace_deleted_at`,
  a.`deleted_by` as `registrace_deleted_by`,
  b.`ID` as `diary_id`,
  b.`nazev` as `diary_nazev`,
  b.`popis` as `diary_popis`,
  b.`date` as `diary_date`,
  b.`hour_from` as `diary_hour_from`,
  b.`min_from` as `diary_min_from`,
  b.`hour_to` as `diary_hour_to`,
  b.`min_to` as `diary_`,
  b.`desc` as `diary_desc`,
  c.`id` as `user_id`,
  c.`surname` as `user_surname`,
  c.`firstname` as `user_firstname`,
  c.`email` as `user_email`,
  c.`mobil_number` as `user_mobil_number`,
  d.`id` as `aktivita_id`,
  d.`nazev` as `aktivita_nazev`,
  d.`vstupy_min` as `aktivita_vstupy_min`,
  d.`vstupy_max` as `aktivita_vstupy_max`,
  d.`zruseni_zdarma` as `aktivita_zruseni_zdarma`,
  d.`zruseni_zdarma_ts` as `aktivita_zruseni_zdarma_ts`,
  d.`zruseni_neucast` as `aktivita_zruseni_neucast`,
  d.`zruseni_neucast_ts` as `aktivita_zruseni_neucast_ts`,
  d.`registrace_konec` as `aktivita_registrace_konec`,
  d.`registrace_konec_ts` as `aktivita_registrace_konec_ts`,
  e.`id` as `lektor_id`,
  e.`surname` as `lektor_surname`,
  e.`firstname` as `lektor_firstname`,
  UNIX_TIMESTAMP(STR_TO_DATE(b.`date`, '%Y%m%d')) AS `ts_diary_date`
*}

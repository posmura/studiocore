{block content}
<div id="banner">
    {if $user->isLoggedIn()}
        <div class="text-warning text-center p-1 m-0" n:block=title style="font-size: 150%; letter-spacing: 2px">
            <strong>ADMINISTRACE: Aktivita</strong>
            <a n:href="Activity:default" class="btn btn-sm btn-success" style="float: right;">
                <i class="bi bi-arrow-left-circle-fill"></i> Zpět
            </a>
        </div>
    {/if}
</div>

<div id="content">
	
	{if $user->isLoggedIn()}

	    <div class="row">
	        <div class="col-md-4">
	            <div class="border border-1 p-2 mx-1 my-4" style="background-color: #eee;">
	                <div style="font-size: 120%; font-weight: bold;">Aktivita</div>
	                {form aktivitaForm}
	                    <div class="mb-3 mt-3">{label id /}{input id}</div>
	                    <div class="mb-3 mt-3">{label nazev /}{input nazev}<div class="text-danger small">{inputError nazev}</div></div>
	                    <div class="mb-3 mt-3">{label vstupy_min /}{input vstupy_min}<div class="text-danger small">{inputError vstupy_min}</div></div>
	                    <div class="mb-3 mt-3">{label vstupy_max /}{input vstupy_max}<div class="text-danger small">{inputError vstupy_max}</div></div>
	                    <div class="mb-3 mt-3">{label zruseni_zdarma /}{input zruseni_zdarma}<div class="text-danger small">{inputError zruseni_zdarma}</div></div>
	                    <div class="mb-3 mt-3">{label zruseni_neucast /}{input zruseni_neucast}<div class="text-danger small">{inputError zruseni_neucast}</div></div>
	                    <div class="mb-3 mt-3">{label registrace_konec /}{input registrace_konec}<div class="text-danger small">{inputError registrace_konec}</div></div>
	                    <div class="text-center">{input send}</div>
	                {/form}
	            </div>
	        </div>
	    </div>

	{/if}
</div>

{if $user->isLoggedIn()}
	    <script>
	    {ifset $data}
	        function setDataToForm() {
	            // uživatel
            $('#frm-aktivitaForm-id').val({$data->id});
            $('#frm-aktivitaForm-nazev').val({$data->nazev});
            $('#frm-aktivitaForm-vstupy_min').val({$data->vstupy_min});
            $('#frm-aktivitaForm-vstupy_max').val({$data->vstupy_max});
            $('#frm-aktivitaForm-zruseni_zdarma').val({$data->zruseni_zdarma});
            $('#frm-aktivitaForm-zruseni_neucast').val({$data->zruseni_neucast});
            $('#frm-aktivitaForm-registrace_konec').val({$data->registrace_konec});
	        }

	        setDataToForm();
	    {/ifset}
	    </script>
{/if}
